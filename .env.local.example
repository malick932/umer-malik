# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already covered by .gitignore's `.env*` rule.

# Gmail address the contact form sends from and to.
GMAIL_USER=malickumer1@gmail.com

# A Gmail "App Password" (NOT your regular Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the Google account first.
GMAIL_APP_PASSWORD=
